# Set these in the server environment, not in frontend code.
HAVENLY_ENV=development
HAVENLY_ORIGIN=http://localhost:5173
# Omit locally to use backend/data. Use an absolute persistent path on your host.
# HAVENLY_DATA_DIR=/var/lib/havenly
# Optional transactional email for sign-up, password recovery and email changes.
# Create a Brevo account, verify a sender, and put these ONLY in the backend environment.
# BREVO_API_KEY=your-server-side-api-key
# HAVENLY_MAIL_FROM=verified-sender@example.com
