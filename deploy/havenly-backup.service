[Unit]
Description=Encrypt and back up Havenly database and private documents off-site

[Service]
Type=oneshot
User=havenly
Group=havenly
WorkingDirectory=/opt/havenly/backend
EnvironmentFile=/etc/havenly.env
EnvironmentFile=/etc/havenly-backup.env
Environment=XDG_CACHE_HOME=/var/lib/havenly/restic-cache
ExecStart=/opt/havenly/backend/.venv/bin/python offsite_backup.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/havenly
