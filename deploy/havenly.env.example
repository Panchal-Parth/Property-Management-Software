# Copy to /etc/havenly.env on the server; replace every example value.
# Keep this file root-owned and mode 0600. Do not commit the real file.
HAVENLY_ENV=production
HAVENLY_ORIGIN=https://rentals.example.com
HAVENLY_DATA_DIR=/var/lib/havenly
BREVO_API_KEY=REPLACE_WITH_PRIVATE_API_KEY
HAVENLY_MAIL_FROM=owner@your-owned-domain.example
