# Copy to /etc/havenly-backup.env on the server; replace every example value.
# Use the S3 endpoint and bucket shown in your Backblaze B2 account.
# Keep this file root-owned and mode 0600. Do not commit the real file.
RESTIC_REPOSITORY=s3:https://s3.YOUR-B2-REGION.backblazeb2.com/YOUR-PRIVATE-BUCKET/havenly
RESTIC_PASSWORD_FILE=/etc/havenly-restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_B2_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_B2_APPLICATION_KEY
